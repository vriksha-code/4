QUESTION 6: NEUMORPHIC CALCULATOR INTERFACE
============================================================

<!DOCTYPE html>
<html>
<head>
<style>
:root {
    --bg: #e0e5ec;
    --shadow: 8px;
    --light: #ffffff;
    --dark: #a3b1c6;
}

body {
    background: var(--bg);
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.calculator {
    width: 300px;
    padding: 20px;
    border-radius: 20px;
    background: var(--bg);
    box-shadow:
        var(--shadow) var(--shadow) 16px var(--dark),
        calc(var(--shadow) * -1) calc(var(--shadow) * -1) 16px var(--light);
}

.display {
    background: var(--bg);
    padding: 20px;
    text-align: right;
    font-size: 28px;
    border-radius: 10px;
    margin-bottom: 20px;
    box-shadow:
        inset 4px 4px 8px var(--dark),
        inset -4px -4px 8px var(--light);
}

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

button {
    padding: 18px;
    border: none;
    border-radius: 10px;
    background: var(--bg);
    font-size: 18px;
    cursor: pointer;
    box-shadow:
        5px 5px 8px var(--dark),
        -5px -5px 8px var(--light);
}

button:active {
    box-shadow:
        inset 4px 4px 6px var(--dark),
        inset -4px -4px 6px var(--light);
}
</style>
</head>

<body>
<div class="calculator">
    <div class="display">123</div>

    <div class="buttons">
        <button>7</button>
        <button>8</button>
        <button>9</button>
        <button>/</button>

        <button>4</button>
        <button>5</button>
        <button>6</button>
        <button>*</button>

        <button>1</button>
        <button>2</button>
        <button>3</button>
        <button>-</button>

        <button>0</button>
        <button>C</button>
        <button>=</button>
        <button>+</button>
    </div>
</div>
</body>
</html>


