QUESTION 1: HOLY GRAIL LAYOUT WITH CSS GRID
============================================================

<!DOCTYPE html>
<html>
<head>
<style>
* {
    box-sizing: border-box;
}

.container {
    display: grid;
    grid-template-columns: 200px 1fr 200px;
    grid-template-rows: 80px 1fr 60px;
    grid-template-areas:
        "header header header"
        "left main right"
        "footer footer footer";
    min-height: 100vh;
    gap: 10px;
    padding: 10px;
}

header {
    grid-area: header;
    background: steelblue;
}

.left {
    grid-area: left;
    background: lightcoral;
}

main {
    grid-area: main;
    background: lightgreen;
}

.right {
    grid-area: right;
    background: lightyellow;
}

footer {
    grid-area: footer;
    background: steelblue;
}

header, .left, main, .right, footer {
    padding: 20px;
    text-align: center;
}

@media (max-width: 767px) {
    .container {
        grid-template-columns: 1fr;
        grid-template-rows: 80px auto auto auto 60px;
        grid-template-areas:
            "header"
            "left"
            "main"
            "right"
            "footer";
    }
}
</style>
</head>

<body>
<div class="container">
    <header>Header</header>
    <aside class="left">Left Sidebar</aside>
    <main>Main Content</main>
    <aside class="right">Right Sidebar</aside>
    <footer>Footer</footer>
</div>
</body>
</html>


