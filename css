QUESTION 7: REUSABLE CSS TOOLTIPS
============================================================

<!DOCTYPE html>
<html>
<head>
<style>
body {
    font-family: Arial, sans-serif;
    padding: 100px;
    text-align: center;
}

.tooltip {
    position: relative;
    display: inline-block;
    margin: 30px;
    padding: 12px 20px;
    background: steelblue;
    color: white;
    cursor: pointer;
}

.tooltip::after {
    content: attr(data-tip);
    position: absolute;
    background: #222;
    color: white;
    padding: 8px 12px;
    border-radius: 5px;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
}

/* Top */
.top::after {
    bottom: 130%;
    left: 50%;
    transform: translateX(-50%);
}

/* Bottom */
.bottom::after {
    top: 130%;
    left: 50%;
    transform: translateX(-50%);
}

/* Right */
.right::after {
    left: 130%;
    top: 50%;
    transform: translateY(-50%);
}

/* Left */
.left::after {
    right: 130%;
    top: 50%;
    transform: translateY(-50%);
}

.tooltip:hover::after {
    opacity: 1;
    visibility: visible;
}

/* Tooltip arrow */
.tooltip::before {
    content: "";
    position: absolute;
    border: 6px solid transparent;
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
}

.top::before {
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-top-color: #222;
}

.bottom::before {
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-bottom-color: #222;
}

.right::before {
    left: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-right-color: #222;
}

.left::before {
    right: 100%;
    top: 50%;
    transform: translateY(-50%);
    border-left-color: #222;
}

.tooltip:hover::before {
    opacity: 1;
    visibility: visible;
}
</style>
</head>

<body>
<span class="tooltip top" data-tip="Tooltip on top">Top</span>
<span class="tooltip bottom" data-tip="Tooltip on bottom">Bottom</span>
<span class="tooltip left" data-tip="Tooltip on left">Left</span>
<span class="tooltip right" data-tip="Tooltip on right">Right</span>
</body>
</html>


