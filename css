QUESTION 3: FLOATING LABEL INPUT
============================================================

<!DOCTYPE html>
<html>
<head>
<style>
body {
    font-family: Arial, sans-serif;
    padding: 50px;
    background: #f2f2f2;
}

.box {
    position: relative;
    width: 300px;
    margin: auto;
}

input {
    width: 100%;
    padding: 15px;
    font-size: 16px;
    border: 2px solid gray;
    border-radius: 5px;
    outline: none;
}

label {
    position: absolute;
    left: 12px;
    top: 15px;
    color: gray;
    background: white;
    padding: 0 5px;
    transition: 0.3s;
    pointer-events: none;
}

input:focus {
    border-color: #2563eb;
}

input:focus + label,
input:not(:placeholder-shown) + label {
    top: -9px;
    font-size: 12px;
    color: #2563eb;
}
</style>
</head>

<body>
<div class="box">
    <input type="text" id="name" placeholder=" ">
    <label for="name">Enter Your Name</label>
</div>
</body>
</html>


